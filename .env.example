# Resend — contact form notifications and auto-replies (https://resend.com)
# Verify nexaipla.com in Resend before sending from contact@nexaipla.com
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=contact@nexaipla.com
CONTACT_FROM_EMAIL=contact@nexaipla.com
CONTACT_EMAIL_SUBJECT=Επικοινωνία — NexAI
# Optional display name when CONTACT_FROM_EMAIL is a bare address
# CONTACT_FROM_NAME=NexAIpla
# Optional auto-reply subjects (defaults are bilingual EL/EN)
# CONTACT_AUTOREPLY_SUBJECT_EL=Ευχαριστούμε που επικοινωνήσατε με την NexAIpla
# CONTACT_AUTOREPLY_SUBJECT_EN=Thanks for contacting NexAIpla

# Vercel Blob — voice recordings from /ai consultation form (link sent in notification email)
# Create a Blob store in Vercel → Storage → Connect → copy BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
